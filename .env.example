# FeedSpine Environment Configuration
# Copy to .env and customize
#
# All settings use the FEEDSPINE_ prefix and are loaded by FeedSpineSettings
# (feedspine.core.config). See SpineBaseSettings for base fields.
#
# Standalone mode: feed-spine works without spine-core installed.
# The defaults below use SQLite — no external services needed.
# Just `pip install feedspine` and run.

# =============================================================================
# Application
# =============================================================================
FEEDSPINE_DEBUG=false
FEEDSPINE_LOG_LEVEL=INFO
FEEDSPINE_LOG_FORMAT=json

# =============================================================================
# API Server
# =============================================================================
FEEDSPINE_HOST=0.0.0.0
FEEDSPINE_PORT=11300

# =============================================================================
# Database / Storage
# =============================================================================
# Storage backend type: memory, sqlite, duckdb, postgresql, timescale
FEEDSPINE_STORAGE=sqlite

# Connection string for database backends
# SQLite (default - zero config)
FEEDSPINE_STORAGE_CONNECTION=sqlite:///./data/feeds.db

# DuckDB (uncomment for analytics-optimized storage)
# FEEDSPINE_STORAGE=duckdb
# FEEDSPINE_STORAGE_CONNECTION=./data/feedspine.duckdb

# PostgreSQL (uncomment for production — uses shared spine-postgres-local)
# FEEDSPINE_STORAGE=postgresql
# FEEDSPINE_STORAGE_CONNECTION=postgresql://<user>:<password>@localhost:10432/feeds
# FEEDSPINE_DATABASE_URL=postgresql+asyncpg://<user>:<password>@localhost:10432/feeds

# TimescaleDB (uncomment for time-series optimized)
# FEEDSPINE_STORAGE=timescale
# FEEDSPINE_STORAGE_CONNECTION=postgresql://<user>:<password>@localhost:10432/feedspine

# Database pool settings
FEEDSPINE_POOL_SIZE=5
FEEDSPINE_BATCH_SIZE=1000

# =============================================================================
# CORS
# =============================================================================
FEEDSPINE_CORS_ORIGINS=http://localhost:3010,http://localhost:5173,http://localhost:11300

# =============================================================================
# API Authentication
# =============================================================================
# Enable to require X-API-Key header for all API endpoints (except health/docs)
FEEDSPINE_REQUIRE_AUTH=false

# API key for authentication (change this in production!)
# FEEDSPINE_API_KEY=your-secure-api-key-here

# =============================================================================
# Feed Capture Settings
# =============================================================================
# Request timeout in seconds
FEEDSPINE_REQUEST_TIMEOUT=30

# =============================================================================
# Redis (for cache and task queue)
# =============================================================================
FEEDSPINE_REDIS_URL=redis://localhost:6379/0

# =============================================================================
# Data Directory
# =============================================================================
FEEDSPINE_DATA_DIR=./data
